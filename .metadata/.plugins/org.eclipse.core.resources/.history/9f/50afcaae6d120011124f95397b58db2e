package com.msc_products.servicios;

import java.util.List;
import java.util.function.Consumer;
import java.util.function.Predicate;
import java.util.function.Supplier;

import com.msc_products.dominio.modelo.Producto;
import com.msc_products.infraestructura.entidad.ProductosEntity;
import com.msc_products.repositorio.ProductoRepository;

public class ProductoServicio {

	private final ProductoRepository repository;

    public ProductoServicio(ProductoRepository repository) {
        this.repository = repository;
    }

    public Producto getById(Long id) {

        return repository.findById(id)
                .map(this::toRecord)
                .orElseThrow(() -> new ProductNotFoundException(id));
    }

    public List<Producto> findExpensive(Double minPrice) {

        Supplier<List<ProductosEntity>> supplier =
                repository::findAll;

        Predicate<ProductosEntity> expensiveFilter =
                p -> p.getPrice() > minPrice;

        Consumer<ProductosEntity> logger =
                p -> System.out.println("Evaluando: " + p.getName());

        return supplier.get()
                .stream()
                .peek(logger)
                .filter(expensiveFilter)
                .map(this::toRecord)
                .toList();
    }

    private Producto toRecord(ProductosEntity entity) {
        return new Producto(
                entity.getId(),
                entity.getName(),
                entity.getPrice()
        );
    }
}	
	
	

