package com.msc_products.servicios;

import java.math.BigDecimal;
import java.util.List;
import java.util.function.Consumer;
import java.util.function.Predicate;
import java.util.function.Supplier;

import org.springframework.stereotype.Service;

import com.msc_products.dominio.excepcion.ProductoNoEncontradoException;
import com.msc_products.dominio.modelo.Producto;
import com.msc_products.dominio.modelo.dto.ProductoPeticion;
import com.msc_products.infraestructura.entidad.ProductosEntity;
import com.msc_products.repositorio.ProductoRepository;

import reactor.core.publisher.Mono;
@Service
public class ProductoServicio {

	private final ProductoRepository repository;

    public ProductoServicio(ProductoRepository repository) {
        this.repository = repository;
    }

    
    public Mono<Producto> crearProducto(ProductoPeticion peticion) {

        ProductosEntity entity = new ProductosEntity(
        		peticion.nombre(),
        		peticion.precio()
        );

        return Mono.fromSupplier(() -> repository.save(entity))
                .map(saved -> new Producto(
                        saved.getId(),
                        saved.getNombre(),
                        saved.getPrecio()
                ));
    }
    
    
    public Producto ObtenerPorId(Long id) {

        return repository.findById(id)
                .map(entidad -> toRecord(entidad))
                .orElseThrow(() -> new ProductoNoEncontradoException(id));
    }
    

    public List<Producto> buscarPrecioElevado(BigDecimal precioMinimmo) {

        Supplier<List <ProductosEntity> > supplier = repository::findAll;

        Predicate<ProductosEntity> filtroPrecioElevado =
        		 p -> p.getPrecio().compareTo(precioMinimmo) > 0;

        Consumer<ProductosEntity> logger =
                p -> System.out.println("visualizando el nombre: " + p.getNombre());

        return supplier.get()
                .stream()
                .peek(logger)
                .filter(filtroPrecioElevado)
                .map(entidad -> toRecord(entidad))
                .toList();
    }

     // de entidad a Record
    private Producto toRecord(ProductosEntity entidad) {
        return new Producto(
        		entidad.getId(),
        		entidad.getNombre(),
        		entidad.getPrecio()
        );
        
    }
    
}	
	
	

