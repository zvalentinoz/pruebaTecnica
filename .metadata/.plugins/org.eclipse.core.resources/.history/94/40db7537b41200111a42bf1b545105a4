package com.msc_products.controladores;

import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.msc_products.dominio.modelo.Producto;
import com.msc_products.dominio.modelo.dto.ProductoPeticion;
import com.msc_products.dominio.modelo.dto.ProductoRespuesta;
import com.msc_products.servicios.ProductoServicio;

import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;
import reactor.core.publisher.Mono;

@RestController
@RequestMapping("/products")
public class ProductoControlador {


@Tag(name = "Productos", description = "API de gestión de productos")
@RestController
@RequestMapping("/api/productos")
public class ProductoController {

    private final ProductoServicio service;

    @Operation(summary = "Crear un producto")
    @PostMapping
    public Mono<ResponseEntity<ProductoRespuesta>> crearProducto(
            @Valid @RequestBody ProductoPeticion request) {

        return service.crearProducto(request)
                .map(producto -> ResponseEntity.ok(
                        new ProductoResponse(
                                producto.id(),
                                producto.nombre(),
                                producto.price()
                        )
                ));
    }

    @Operation(summary = "Obtener producto por ID")
    @GetMapping("/{id}")
    public Mono<ResponseEntity<ProductoResponse>> obtenerProducto(
            @PathVariable Long id) {

        return service.obtenerProducto(id)
                .map(producto -> ResponseEntity.ok(
                        new ProductoResponse(
                                producto.id(),
                                producto.nombre(),
                                producto.price()
                        )
                ));
    }
    
}
