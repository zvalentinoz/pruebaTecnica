package com.mcs_discount.clientes;

import org.springframework.stereotype.Component;
import org.springframework.web.reactive.function.client.WebClient;

import com.mcs_discount.dominio.dto.ProductoRespuesta;

import reactor.core.publisher.Mono;

@Component
public class ProductoCliente {

    private final WebClient webClient;

    public ProductoCliente(WebClient.Builder builder) {
        this.webClient = builder
                .baseUrl("http://localhost:8081")
                .build();
    }

    public Mono<ProductoRespuesta> obtenerProducto(Long id) {
        return webClient.get()
                .uri("/api/productos/{id}", id)
                .retrieve()
                .bodyToMono(ProductoRespuesta.class)
                .onStatus(status -> status.is4xxClientError(),
                        resp -> Mono.error(new RuntimeException("Producto no encontrado")))
              .onStatus(status -> status.is5xxServerError(),
                        resp -> Mono.error(new RuntimeException("Error en Product Service")));
    }
}