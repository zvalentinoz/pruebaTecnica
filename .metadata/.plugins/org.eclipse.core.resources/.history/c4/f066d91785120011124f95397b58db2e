package com.mcs_discount.servicio;

import org.springframework.stereotype.Service;

@Service
public class DescuentoServicio {

	 private final ProductClient client;
	    private final DiscountRepository repository;

	    public DiscountService(ProductClient client,
	                           DiscountRepository repository) {
	        this.client = client;
	        this.repository = repository;
	    }

	    public Mono<Discount> calculateDiscount(Long productId) {

	        return client.getProduct(productId)

	                .map(product -> {

	                    Double discounted =
	                            product.price() > 100
	                                    ? product.price() * 0.9
	                                    : product.price() * 0.95;

	                    return new DiscountEntity(
	                            productId,
	                            product.price(),
	                            discounted
	                    );
	                })

	                .map(repository::save)

	                .map(entity -> new Discount(
	                        entity.getId(),
	                        entity.getProductId(),
	                        entity.getOriginalPrice(),
	                        entity.getDiscountedPrice()
	                ))

	                .onErrorResume(e ->
	                        Mono.error(
	                                new DiscountException(
	                                        "Error procesando descuento"
	                                )
	                        )
	                );
	    }
	
}
