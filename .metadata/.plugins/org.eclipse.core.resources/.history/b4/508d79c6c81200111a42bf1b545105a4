package com.mcs_discount.controlador;



import com.mcs_discount.dominio.dto.DescuentoRespuesta;
import com.mcs_discount.dominio.modelo.Descuento;
import com.mcs_discount.servicio.DescuentoServicio;

import io.swagger.v3.oas.annotations.tags.Tag;
import jakarta.validation.Valid;
import lombok.RequiredArgsConstructor;

import java.math.BigDecimal;

import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import reactor.core.publisher.Mono;

@RestController
@RequiredArgsConstructor
@RequestMapping("/api/descuentos")
@Tag(name = "Descuentos", description = "API de cálculo de descuentos de productos")
public class DescuentoControlador {

    private final DescuentoServicio descuentoServicio;

    
    @Operation(summary = "Obtener descuento de un producto", description = "Calcula el descuento de un producto usando reglas internas")
    @ApiResponses(value = {
        @ApiResponse(responseCode = "200", description = "Descuento calculado correctamente"),
        @ApiResponse(responseCode = "404", description = "Producto no encontrado"),
        @ApiResponse(responseCode = "500", description = "Error interno al calcular descuento")
    })
    @GetMapping("/{productId}")
    public Mono<ResponseEntity<DescuentoRespuesta>> obtenerDescuento(@PathVariable Long productId) {

        return descuentoServicio.calcularDescuento(productId)
                .map(descuento -> {
                    BigDecimal montoDescontado = descuento.precioOriginal()
                                                           .subtract(descuento.precioFinal());

                    DescuentoRespuesta response = new DescuentoRespuesta(
                            descuento.precioOriginal(),
                            montoDescontado,
                            descuento.precioFinal()
                    );
                    return ResponseEntity.ok(response);
                });
    }
}
