package com.msc_products.controladores;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.msc_products.servicios.ProductoServicio;

import reactor.core.publisher.Mono;

@RestController
@RequestMapping("/products")
public class ProductoControlador {

    private final ProductoServicio service;

    public ProductoControlador(ProductoServicio service) {
        this.service = service;
    }

    @GetMapping("/{id}")
    public Mono<Producto> getProduct(@PathVariable Long id) {
        return Mono.fromSupplier(() -> service.getById(id));
    }
}
