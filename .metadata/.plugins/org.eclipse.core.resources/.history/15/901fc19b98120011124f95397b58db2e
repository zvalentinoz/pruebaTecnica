package com.mcs_discount.infraestructura.entidad;

import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.Table;

@Entity
@Table(name = "discounts")
public class DescuentoEntity {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    private Long productoId;
    private Double precioOriginal;
    private Double descuentoPrecio;

    protected DescuentoEntity() {}

    public DescuentoEntity(Long productId,Double precioOriginal,Double descuentoPrecio) {
        this.productoId = productId;
        this.precioOriginal = precioOriginal;
        this.descuentoPrecio = descuentoPrecio;
    }
    
    

    public Long getId() {
    	return id;
    	}
    public Long getProductoId() {
    	return productId;
    	}
    public Double getPrecioOriginal() {
    	return precioOriginal;
    	}
    public Double getDescuentoPrecio() {
    	return descuentoPrecio;
    	}
}