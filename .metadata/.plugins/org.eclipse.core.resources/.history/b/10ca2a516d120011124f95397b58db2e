package com.msc_products.servicios;

public class ProductoServicio {

	private final ProductRepository repository;

    public ProductoService(ProductRepository repository) {
        this.repository = repository;
    }

    public Product getById(Long id) {

        return repository.findById(id)
                .map(this::toRecord)
                .orElseThrow(() -> new ProductNotFoundException(id));
    }

    public List<Product> findExpensive(Double minPrice) {

        Supplier<List<ProductEntity>> supplier =
                repository::findAll;

        Predicate<ProductEntity> expensiveFilter =
                p -> p.getPrice() > minPrice;

        Consumer<ProductEntity> logger =
                p -> System.out.println("Evaluando: " + p.getName());

        return supplier.get()
                .stream()
                .peek(logger)
                .filter(expensiveFilter)
                .map(this::toRecord)
                .toList();
    }

    private Product toRecord(ProductEntity entity) {
        return new Product(
                entity.getId(),
                entity.getName(),
                entity.getPrice()
        );
    }
}	
	
	

